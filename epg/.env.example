# Aliran EPG service configuration. Copy to .env and edit.

# Where the corestore and epoch state live.
DATA_DIR=./data

# The panel this guide belongs to (64 hex chars).
PANEL_PUBKEY=

# Publisher identity for the ONE panel write this service makes (meta/epgKey).
# Enroll the publisher in the panel with scope "epg".
PUBLISHER_KEY=
PUBLISHER_NAME=epg1

# Guide window and rotation. The drive is append-only inside, so a fresh drive is
# minted every EPOCH_DAYS; the old drive stays served for GRACE_HOURS, then purged.
GUIDE_DAYS=7
EPOCH_DAYS=30
GRACE_HOURS=48

# Ingest provider list (JSON file, see providers.example.json).
PROVIDERS_FILE=./providers.json
REFRESH_HOURS=6

# Opt-in status endpoint (loopback only unless STATUS_HOST is widened).
STATUS_ENABLED=0
STATUS_PORT=3340

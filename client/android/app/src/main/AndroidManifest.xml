<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Google Cast ("Play on a TV", phone). The Cast framework reads both to find
         receivers on the local network; neither is a runtime permission and neither
         prompts. They are normal permissions, so a device that cannot cast at all (no
         Play Services) simply never uses them.

         ANDROID 16 / LOCAL NETWORK PROTECTION — checked, and the answer is DO NOTHING
         YET. The permission is android.permission.ACCESS_LOCAL_NETWORK and Google's own
         guidance is explicit: declare and request it only when targeting SDK 37 or
         higher. Apps at SDK 36 or lower (this app targets 36) keep implicit local-network
         access through INTERNET, and in Android 16 the restriction is opt-in behind a
         developer/compat flag rather than enforced. Declaring it now would be a
         permission in the manifest that grants nothing and appears on a listing.

         IT WILL MATTER AT targetSdk 37, AND IN BOTH DIRECTIONS. Casting needs OUTBOUND
         local access (mDNS discovery, and the connection to the receiver on port 8009)
         AND INBOUND — the engine's cast server accepts a TCP connection FROM the
         television, which the same permission covers. So the day this app moves to SDK
         37, this feature needs ACCESS_LOCAL_NETWORK plus a runtime request, or it stops
         working at both ends. See docs at
         developer.android.com/privacy-and-security/local-network-permission -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- The Cast framework's media notification — the transport controls on the shade and
         the lock screen while this phone casts. GoogleCastOptionsProvider configures it
         unconditionally (CastMediaOptions.setNotificationOptions) and from API 33 the
         framework cannot post it without this permission, so without the line the
         notification simply never appeared on any current device.

         DECLARING IT IS HALF THE JOB — it is a RUNTIME permission. cast.ts asks for it
         when a cast actually starts, which is the only moment this app has a reason to
         ask. Denied, everything still works: the standing chip on the Live screen is the
         in-app sign that a session is running, and it does not depend on the platform. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:banner="@drawable/tv_banner"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:networkSecurityConfig="@xml/network_security_config"
      android:supportsRtl="true">
      <!-- screenOrientation: phones rotate freely (the portrait guide renders the playing
           stream above the grid); leanback/TV devices are landscape by nature, so
           "unspecified" keeps them exactly as sensorLandscape did. -->
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:screenOrientation="unspecified"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent-filter>
      </activity>
      <!-- THE CAST EXPANDED CONTROLLER. Declared here because nothing else will: the
           class lives in react-native-google-cast, whose own AndroidManifest.xml is
           EMPTY, and the library's Expo config plugin is what normally injects this
           <activity> — an app that does not use Expo (this one) gets nothing.

           It is not optional decoration. CastOptionsProvider extends the library's
           provider and inherits getCastOptions() verbatim, and that method calls
           setExpandedControllerActivityClassName(RNGCExpandedControllerActivity) — so the
           framework's media notification and the lock-screen controls both target this
           class by name. Undeclared, tapping either threw ActivityNotFoundException.

           No intent-filter, so it is not exported and nothing outside the app can start
           it. It inherits AppTheme, which is Theme.AppCompat.DayNight.NoActionBar — what
           ExpandedControllerActivity needs, since it installs its own toolbar. -->
      <activity
        android:name="com.reactnative.googlecast.RNGCExpandedControllerActivity"
        android:label="@string/app_name"
        android:exported="false" />
      <!-- Google Cast configuration. The framework instantiates this class itself the
           first time CastContext.getSharedInstance() runs (MainActivity, guarded) and
           reads the receiver id from it: the STOCK receiver CC1AD845, so no Cast
           Developer Console registration and nothing an operator has to host. See
           CastOptionsProvider.kt. -->
      <meta-data
        android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
        android:value="com.aliranclient.CastOptionsProvider" />
    </application>
</manifest>

# Dependencies
node_modules/
*/node_modules/

# Secrets & per-deployment data — NEVER commit keys
.env
*/.env
.env.local
**/keys/
**/*.key
**/store/
**/corestore/
**/data/
# extra local data dirs for multi-broadcaster dev (data-two, …)
**/data-*/
storage/
secrets/

# GeoIP databases (operator-provided)
**/GeoLite2*.mmdb

# Logs
*.log
logs/
npm-debug.log*

# Build output
dist/
build/
/site/
*.bundle
client/android/app/build/
client/android/build/
client/android/.gradle/
client/ios/build/
*.apk
*.aab

# React Native / Metro
.metro-health-check*
client/.expo/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Desktop player — per-deployment descriptor is operator-local (see service.example.json)
desktop/config/service.json

# Aliran MCP server — operator-local config (holds admin passwords + the SSH key
# path) and its persisted token cache. Only config.example.json is committed.
# docs-bundle/ is generated by prepack (scripts/bundle-docs.mjs) for the published
# tarball; a repo checkout reads the live docs/ instead.
mcp/config.json
**/.aliran-mcp-state/
mcp/docs-bundle/
mcp/*.tgz

# Claude Code local workspace — personal permissions, dev-server launch configs
# and scratch worktrees. Editor/assistant tooling stays out of the public repo.
.claude/

# Project-scope MCP client wiring for the aliran MCP server (machine-local
# absolute paths — each operator generates their own via `--doctor`)
.mcp.json

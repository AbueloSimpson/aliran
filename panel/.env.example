# Aliran panel configuration — copy to .env and edit. NEVER commit .env.

# Storage (Corestore + keys). Gitignored. Back this up securely.
DATA_DIR=./data

# Route via DHT relays so peers can't see the origin IP (default off).
RELAY_ONLY=false

# Your service name. The app shows it when a viewer pairs with the service pairing
# code — before the viewer signs in. Public display text only.
SERVICE_NAME=Aliran

# Argon2id cost (tune to target client hardware; higher = safer, slower login).
ARGON2_MEM_KIB=262144
ARGON2_TIME=3

# Accounts / sessions
MAX_DEVICES_DEFAULT=2
SESSION_TTL_DAYS=30

# Brute-force controls
POW_DIFFICULTY=16
LOCKOUT_THRESHOLD=10
LOCKOUT_SECONDS=900

# Accept UNNAMED broadcaster registrations signed with the shared legacy publisher
# key from `admin-cli init`. Once every broadcaster site is enrolled with its own
# key + channel scopes (`admin-cli add-publisher`, PUBLISHER_NAME in its .env),
# set 0 so only enrolled identities can register.
LEGACY_PUBLISHER=1

# Admin HTTP API (dashboard/control plane). Off by default. Create an admin first:
#   node src/admin-cli.js add-admin <name>
# Bind loopback unless you have TLS in front (the API speaks plain HTTP).
ADMIN_ENABLED=false
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3210
ADMIN_SESSION_TTL_HOURS=12

# Encrypted key escrow — the supported way to get DATA_DIR/keys/ off this box.
# See docs/kb/backup-and-rotation.md.
#
# The CLI export (`node src/admin-cli.js export-escrow`) needs shell access here and
# always works. The switch below adds the same export to the DASHBOARD, which lowers
# the bar for stealing the identity from "shell access on the box" to "an admin
# session plus that admin's password". Therefore it is OFF, and you turn it on
# deliberately. When it is on the panel also asks for the password again, permits 3
# attempts per hour, and records every attempt in the activity feed.
#ESCROW_EXPORT=0
#
# Argon2id cost for the EXPORTED FILE. That file lives outside every control this box
# has, and the passphrase is its only protection — so raise this if the box can take
# it. You pay the cost once per export, in a worker thread. Defaults: 256 MiB, 3 ops.
# The values travel inside each file, so an older file always opens with its own.
#ESCROW_ARGON2_MEM_MIB=256
#ESCROW_ARGON2_OPS=3

# Optional: custom DHT bootstrap nodes (comma-separated host:port). Empty = public DHT.
BOOTSTRAP=

# Swarm UDP socket buffers, in MB (0 = leave that direction alone). Every client
# replicates the catalog over the panel's single swarm, so its socket pair carries the
# whole lineup's fan-out. A full UDP buffer is a silent kernel packet drop (netstat -su).
# Only takes effect if the HOST allows it: setsockopt is silently clamped to
# net.core.{r,w}mem_max, which ships at 212992 on stock Linux. Optional helper to raise it:
# deploy/sysctl/install.sh. The panel logs a warning naming the exact sysctl if its
# request was capped. Defaults: 2/2.
# SWARM_RCVBUF_MB=2
# SWARM_SNDBUF_MB=2

# Structured logs (optional): json = one {ts,level,svc,msg} JSON object per line
# for log shippers. Unset keeps the human-readable lines.
#LOG_FORMAT=json

# Viewer problem reports (S50). Viewers send pseudonymous problem reports over the
# EXISTING P2P RPC socket (no new port); they land under DATA_DIR/reports/. No
# username and no device id is ever stored — the panel HMACs the session identity
# with a per-deployment salt (DATA_DIR/secrets/reports-salt) into a 16-hex reporter
# pseudonym. RETENTION_DAYS=0 is the kill switch: nothing is collected and the
# `report` RPC method is not served at all.
#REPORTS_RETENTION_DAYS=30
# Per-reporter rate limit (reports per window).
#REPORTS_MAX_PER_WINDOW=5
#REPORTS_WINDOW_SECONDS=600
# Correlation: this many DISTINCT reporters on one channel inside this many minutes
# opens ONE alert (further reports extend it — they never open a second).
#REPORTS_ALERT_COUNT=3
#REPORTS_ALERT_WINDOW_MIN=10
# Storm collapse: once an alert is open, only this many full records are kept for it;
# everything else just bumps the alert's tally (no disk write on the hot path).
#REPORTS_STORM_SAMPLE=20
# Panel-wide breaker: reports past this many per minute are acknowledged and dropped.
#REPORTS_GLOBAL_PER_MIN=120
# Ops notifications (S50b) — unset = no notifier at all. The webhook body suits
# ntfy / Slack / Discord alike. The Telegram token is a SECRET: keep it out of
# anything you share.
#REPORTS_WEBHOOK_URL=
#REPORTS_TELEGRAM_BOT_TOKEN=
#REPORTS_TELEGRAM_CHAT_ID=
